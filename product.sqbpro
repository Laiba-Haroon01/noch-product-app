s><column index="1" value="71"/><column index="2" value="76"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="product_images" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="71"/><column index="3" value="64"/><column index="4" value="68"/><column index="5" value="84"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="products" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="85"/><column index="2" value="273"/><column index="3" value="296"/><column index="4" value="46"/><column index="5" value="91"/><column index="6" value="47"/><column index="7" value="85"/><column index="8" value="54"/><column index="9" value="148"/><column index="10" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ============================================================
--  NOCH Marketplace -- Products Component SQL Schema
--  Designed for SQLite (compatible with MySQL with minor changes)
--  Author: Products Component
-- ============================================================

PRAGMA foreign_keys = ON;

-- ============================================================
-- 1. LOGIN / AUTHENTICATION
--    Required by: Products (staff login to manage products)
-- ============================================================
CREATE TABLE IF NOT EXISTS login_authentication (
    user_id         TEXT PRIMARY KEY,               -- e.g. USR-00001
    email           TEXT NOT NULL UNIQUE,
    password_hash   TEXT NOT NULL,
    role            TEXT NOT NULL CHECK (role IN ('Customer', 'Staff')),
    is_active       INTEGER NOT NULL DEFAULT 1      -- 1 = active, 0 = inactive
);

-- ============================================================
-- 2. CATEGORY
--    Products can belong to one or more categories
-- ============================================================
CREATE TABLE IF NOT EXISTS category (
    category_id     TEXT PRIMARY KEY,               -- e.g. CAT-00001
    category_name   TEXT NOT NULL UNIQUE,
    category_type   TEXT NOT NULL CHECK (category_type IN ('Men', 'Women', 'Unisex')),
    description     TEXT
);

-- Seed the standard categories from the React source
INSERT OR IGNORE INTO category VALUES ('CAT-00001', 'Tops',        'Unisex', 'Tops and shirts');
INSERT OR IGNORE INTO category VALUES ('CAT-00002', 'Bottoms',     'Unisex', 'Trousers, shorts, jeans');
INSERT OR IGNORE INTO category VALUES ('CAT-00003', 'Dresses',     'Women',  'Dresses and skirts');
INSERT OR IGNORE INTO category VALUES ('CAT-00004', 'Outerwear',   'Unisex', 'Coats, jackets, blazers');
INSERT OR IGNORE INTO category VALUES ('CAT-00005', 'Accessories', 'Unisex', 'Jewellery, belts, scarves');

-- ============================================================
-- 3. PRODUCTS  (core table for this component)
-- ============================================================
CREATE TABLE IF NOT EXISTS products (
    product_id      TEXT PRIMARY KEY,               -- e.g. NOCH-00001
    product_name    TEXT NOT NULL UNIQUE,           -- must be unique, not null
    description     TEXT,
    price           REAL NOT NULL CHECK (price &gt; 0),           -- positive number
    stock_quantity  INTEGER NOT NULL CHECK (stock_quantity &gt;= 0), -- non-negative
    gender          TEXT NOT NULL CHECK (gender IN ('Men', 'Women', 'Unisex')),
    color           TEXT NOT NULL,
    activity        TEXT NOT NULL DEFAULT 'Active'
                    CHECK (activity IN ('Active', 'Inactive')), -- active/inactive
    category        TEXT NOT NULL,                  -- comma-separated display value
    image           TEXT                            -- primary image URL (VARCHAR 500)
);

-- ============================================================
-- 4. PRODUCT_IMAGES
--    One product can have 1–4 images
-- ============================================================
CREATE TABLE IF NOT EXISTS product_images (
    image_id        TEXT PRIMARY KEY,               -- e.g. IMG-00001
    product_id      TEXT NOT NULL,
    image_url       TEXT NOT NULL CHECK (LENGTH(image_url) &lt;= 900),
    is_primary      INTEGER NOT NULL DEFAULT 0 CHECK (is_primary IN (0, 1)),
    display_order   INTEGER NOT NULL DEFAULT 1 CHECK (display_order BETWEEN 1 AND 4),

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- Each product can have at most 4 images (enforced by trigger)
CREATE TRIGGER IF NOT EXISTS trg_max_4_images
BEFORE INSERT ON product_images
BEGIN
    SELECT CASE
        WHEN (SELECT COUNT(*) FROM product_images
              WHERE product_id = NEW.product_id) &gt;= 4
        THEN RAISE(ABORT, 'A product cannot have more than 4 images.')
    END;
END;

-- Each product must have at least 1 image (enforced by trigger on delete)
CREATE TRIGGER IF NOT EXISTS trg_min_1_image
BEFORE DELETE ON product_images
BEGIN
    SELECT CASE
        WHEN (SELECT COUNT(*) FROM product_images
              WHERE product_id = OLD.product_id) &lt;= 1
        THEN RAISE(ABORT, 'A product must have at least 1 image.')
    END;
END;

-- ============================================================
-- 5. PRODUCT_CATEGORY  (many-to-many junction)
--    Links products to one or more categories
-- ============================================================
CREATE TABLE IF NOT EXISTS product_category (
    product_id      TEXT NOT NULL,
    category_id     TEXT NOT NULL,

    PRIMARY KEY (product_id, category_id),

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (category_id)
        REFERENCES category(category_id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

-- ============================================================
-- 6. INVENTORY / WAREHOUSE
--    Tracks stock per product per warehouse
-- ============================================================
CREATE TABLE IF NOT EXISTS inventory_warehouse (
    inventory_id        INTEGER PRIMARY KEY AUTOINCREMENT,
    warehouse_id        INTEGER NOT NULL,
    product_id          TEXT NOT NULL,
    quantity_on_hand    INTEGER NOT NULL DEFAULT 0
                        CHECK (quantity_on_hand &gt;= 0),  -- no negative stock

    UNIQUE (warehouse_id, product_id),                  -- no duplicate entries

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- ============================================================
-- 7. REVIEW
--    Customer reviews linked to products
-- ============================================================
CREATE TABLE IF NOT EXISTS review (
    review_id       TEXT PRIMARY KEY,               -- e.g. REV-00001
    product_id      TEXT NOT NULL,
    customer_id     TEXT NOT NULL,
    rating          INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
    comment         TEXT,
    date_posted     TEXT NOT NULL,                  -- ISO date string
    editable_until  TEXT NOT NULL,                  -- 5 min window (ISO datetime)

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE
);

-- ============================================================
-- 8. CHECKOUT  (basket/cart items)
--    References products via product_id
-- ============================================================
CREATE TABLE IF NOT EXISTS checkout (
    basket_item_id  TEXT PRIMARY KEY,               -- e.g. BKT-00001
    product_id      TEXT NOT NULL,
    customer_id     TEXT NOT NULL,
    quantity        INTEGER NOT NULL DEFAULT 1 CHECK (quantity &gt; 0),
    unit_price      REAL NOT NULL CHECK (unit_price &gt; 0),
    subtotal        REAL GENERATED ALWAYS AS (quantity * unit_price) VIRTUAL,

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

-- ============================================================
-- 9. ORDERS  (order header)
--    References products via order_items
-- ============================================================
CREATE TABLE IF NOT EXISTS orders (
    order_id        INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id     TEXT NOT NULL,
    order_date      TEXT NOT NULL,
    status          TEXT NOT NULL DEFAULT 'Processing'
                    CHECK (status IN
                        ('Processing','Shipped','Delivered','Returned','Cancelled')),
    total           REAL NOT NULL CHECK (total &gt;= 0)
);

-- ============================================================
-- 10. ORDER_ITEMS  (line items — links orders to products)
-- ============================================================
CREATE TABLE IF NOT EXISTS order_items (
    order_item_id   INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id        INTEGER NOT NULL,
    product_id      TEXT NOT NULL,
    quantity        INTEGER NOT NULL CHECK (quantity &gt; 0),
    unit_price      REAL NOT NULL CHECK (unit_price &gt; 0),
    subtotal        REAL GENERATED ALWAYS AS (quantity * unit_price) VIRTUAL,

    FOREIGN KEY (order_id)
        REFERENCES orders(order_id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    FOREIGN KEY (product_id)
        REFERENCES products(product_id)
        ON DELETE RESTRICT
        ON UPDATE CASCADE
);

-- ============================================================
-- INDEXES  (speeds up common queries)
-- ============================================================
CREATE INDEX IF NOT EXISTS idx_products_name       ON products(product_name);
CREATE INDEX IF NOT EXISTS idx_products_activity   ON products(activity);
CREATE INDEX IF NOT EXISTS idx_products_gender     ON products(gender);
CREATE INDEX IF NOT EXISTS idx_products_price      ON products(price);
CREATE INDEX IF NOT EXISTS idx_product_images_pid  ON product_images(product_id);
CREATE INDEX IF NOT EXISTS idx_product_cat_pid     ON product_category(product_id);
CREATE INDEX IF NOT EXISTS idx_product_cat_cid     ON product_category(category_id);
CREATE INDEX IF NOT EXISTS idx_review_pid          ON review(product_id);
CREATE INDEX IF NOT EXISTS idx_checkout_pid        ON checkout(product_id);
CREATE INDEX IF NOT EXISTS idx_order_items_pid     ON order_items(product_id);
CREATE INDEX IF NOT EXISTS idx_inventory_pid       ON inventory_warehouse(product_id);

-- ============================================================
-- SAMPLE SEED DATA  (21 products from the application)
-- ============================================================
